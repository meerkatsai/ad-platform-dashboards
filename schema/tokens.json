{
  "$schema": "./tokens.schema.json",
  "color": {
    "surface": {
      "page": "#FAFAF9",
      "card": "#FFFFFF",
      "sunken": "#F4F4F2",
      "tint": "#FFF7F2"
    },
    "ink": {
      "900": "#0B0B0C",
      "700": "#2A2A2E",
      "500": "#5C5C63",
      "400": "#8A8A92",
      "300": "#B4B4BA"
    },
    "rule": {
      "hairline": "#E4E4E7",
      "strong": "#111113",
      "grid": "#EFEFEC"
    },
    "accent": {
      "default": "#EA580C",
      "hover": "#C2410C",
      "soft": "#FDBA74",
      "tint": "#FFF7F2"
    },
    "status": {
      "good": "#15803D",
      "goodBg": "#ECFDF3",
      "bad": "#B91C1C",
      "badBg": "#FEF2F2"
    },
    "series": {
      "1": "#4285F4",
      "2": "#EA4335",
      "3": "#FBBC04",
      "4": "#34A853",
      "5": "#7E57C2",
      "6": "#00ACC1",
      "7": "#E91E63",
      "8": "#8D6E63",
      "compare": "#8A8A92",
      "dim": "#D4D4D7"
    },
    "bar": {
      "neutral": "#D4D4D7",
      "active": "#4285F4",
      "track": "#F4F4F2"
    },
    "heat": {
      "0": "#FFFFFF",
      "1": "#E8F0FE",
      "2": "#AECBFA",
      "3": "#669DF6",
      "4": "#1A73E8",
      "5": "#174EA6",
      "textDark": "#0B0B0C",
      "textLight": "#FFFFFF"
    },
    "selectTint": "#E8F0FE",
    "chart": {
      "grid": "#EFEFEC",
      "axis": "#8A8A92",
      "crosshair": "#0B0B0C"
    }
  },
  "typography": {
    "family": {
      "ui": "Geist, system-ui, -apple-system, sans-serif",
      "mono": "'Geist Mono', ui-monospace, monospace",
      "display": "'Instrument Serif', Georgia, serif"
    },
    "size": {
      "title": 26,
      "kpi": 28,
      "card": 15,
      "body": 13,
      "label": 12,
      "micro": 11
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "lineHeight": { "tight": 1.15, "body": 1.45 },
    "trackingCaps": "0.06em",
    "tabularNumbers": true
  },
  "shape": {
    "radiusCard": 6,
    "radiusControl": 4,
    "radiusPill": 999,
    "borderHairline": 1,
    "borderStrong": 1.5
  },
  "layout": {
    "pageMaxWidth": 1440,
    "pagePadding": 24,
    "cardGap": 16,
    "cardPaddingX": 20,
    "cardPaddingY": 16,
    "cardHeaderHeight": 48,
    "controlHeight": 32,
    "controlHeightSm": 26,
    "rowHeight": 40
  },
  "chart": {
    "strokeWidth": 2,
    "strokeWidthCompare": 1.5,
    "pointRadius": 4,
    "defaultHeight": 240,
    "sparklineHeight": 28
  },
  "motion": {
    "durationFastMs": 120,
    "durationMs": 200,
    "ease": "cubic-bezier(.2,.7,.2,1)"
  },
  "elevation": {
    "card": "none",
    "float": "0 4px 16px rgba(11,11,12,.10), 0 0 0 1px rgba(11,11,12,.06)"
  },
  "focusRing": "0 0 0 3px rgba(234,88,12,.25)"
}
